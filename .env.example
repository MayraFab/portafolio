# Copia este archivo como ".env" y coloca tus claves de EmailJS
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Panel de administración (Supabase): copia estos valores desde Project Settings → API
# La URL va SOLA, sin "/rest/v1/" al final. Ejemplo: https://abcdefghijklmnopqrst.supabase.co
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
